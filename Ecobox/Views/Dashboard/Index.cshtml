@model Ecobox.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var etiquetaMensaje = TempData["TipoMensajeCapacidad"]?.ToString() == "danger" ? "danger" : "success";
}

<div class="container-xl page-shell dashboard-page">
    <section class="page-heading">
        <div>
            <p class="eyebrow">TECNOLOGÍA AL SERVICO DEL RECICLAJE</p>
            <h1>Panel EcoBox</h1>
            <p class="heading-copy">Contenedor inteligente para la separación de residuos UniCESMAG - Hall San Francisco.</p>
        </div>
    </section>

    <div class="data-notice notice-connected" role="status">
        <span class="notice-dot" aria-hidden="true"></span>
        <span>@Model.MensajeBaseDatos</span>
    </div>

    @if (TempData["MensajeCapacidad"] is string mensajeCapacidad)
    {
        <div class="alert alert-@etiquetaMensaje" role="status">@mensajeCapacidad</div>
    }

    <section class="dashboard-grid" aria-label="Resumen de EcoBox">
        <article class="panel latest-panel">
            <div class="panel-heading">
                <div><p class="eyebrow">ACTIVIDAD RECIENTE</p><h2>Último registro</h2></div>
                <span class="icon-tile icon-green" aria-hidden="true">↘</span>
            </div>
            @if (Model.UltimoRegistro is null)
            {
                <div class="empty-latest">
                    <span class="empty-symbol" aria-hidden="true">◇</span>
                    <p>Aún no hay registros recientes.</p>
                </div>
            }
            else
            {
                <div class="latest-result">
                    <span class="category-pill @(Model.UltimoRegistro.Caneca == Ecobox.Models.CategoriaResiduo.APROVECHABLE ? "category-green" : "category-blue")">@Model.UltimoRegistro.NombreCaneca</span>
                    <p class="latest-date">@Model.UltimoRegistro.Fecha.ToString("dd/MM/yyyy")</p>
                    <p class="latest-time">@Model.UltimoRegistro.Cantidad residuo(s) registrados ese día</p>
                </div>
            }
        </article>

        <article class="panel total-panel">
            <div class="panel-heading">
                <div><p class="eyebrow">OCUPACIÓN TOTAL</p><h2>Total de residuos</h2></div>
                <span class="icon-tile icon-blue" aria-hidden="true">▤</span>
            </div>
            <div class="total-number">@Model.TotalResiduos</div>
            <p class="muted-copy">Unidades actualmente ocupadas en ambas canecas</p>
            <div class="total-breakdown">
                <div><span class="legend-dot legend-green"></span><span>Aprovechables</span><strong>@Model.TotalAprovechables</strong></div>
                <div><span class="legend-dot legend-blue"></span><span>No aprovechables</span><strong>@Model.TotalNoAprovechables</strong></div>
            </div>
        </article>
    </section>

    <section class="bins-section physical-capacity-section" aria-label="Canecas y capacidad física">
        <div class="section-heading">
            <div><p class="eyebrow">CAPACIDAD FÍSICA</p><h2>Ocupación de las canecas</h2></div>
            <span class="section-note">Capacidad máxima individual: 50 unidades</span>
        </div>
        <div class="bin-grid">
            @foreach (var ocupacion in Model.OcupacionesCanecas.OrderBy(item => item.Caneca))
            {
                var esAprovechable = ocupacion.Caneca == Ecobox.Models.CategoriaResiduo.APROVECHABLE;
                var nombreCaneca = esAprovechable ? "Caneca aprovechable" : "Caneca no aprovechable";
                var color = esAprovechable ? "green" : "blue";
                var claseEstado = ocupacion.UnidadesActuales == 0 ? "status-empty"
                    : ocupacion.UnidadesActuales == ocupacion.CapacidadMaxima ? "status-danger"
                    : ocupacion.UnidadesActuales >= 45 ? "status-warning" : "status-ready";
                <article class="panel bin-card physical-bin-card">
                    <div class="bin-card-top">
                        <span class="bin-icon bin-icon-@color" aria-hidden="true">
                            <svg viewBox="0 0 48 48" fill="none"><path d="M12 16h24l-2 25H14l-2-25Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path d="M9 12h30M19 12V8h10v4m-7 9v14m6-14v14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M24 5c-4 3.1-5.2 6-3.6 8.1 1.6 2.1 5.2 1.7 7.5-.2C30.3 11.1 28.4 7.9 24 5Z" fill="currentColor"/></svg>
                        </span>
                        <span class="status-pill @claseEstado">@ocupacion.Estado</span>
                    </div>
                    <h3>@nombreCaneca</h3>
                    <div class="bin-count"><strong>@ocupacion.UnidadesActuales/@ocupacion.CapacidadMaxima</strong><span>unidades de ocupación</span></div>
                    <div class="capacity-label"><span>Porcentaje ocupado</span><strong>@ocupacion.PorcentajeOcupacion%</strong></div>
                    <div class="progress eco-progress" role="progressbar" aria-label="Ocupación de @nombreCaneca" aria-valuenow="@ocupacion.PorcentajeOcupacion" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar progress-@color" style="width: @ocupacion.PorcentajeOcupacion%"></div>
                    </div>
                    <div class="capacity-label remaining-capacity"><span>Unidades restantes</span><strong>@ocupacion.UnidadesRestantes</strong></div>
                    <form asp-controller="Dashboard" asp-action="VaciarCaneca" method="post" class="empty-bin-form" onsubmit="return confirm('¿Confirmas que deseas vaciar la caneca @nombreCaneca? Se conservarán sus registros anteriores.');">
                        <input type="hidden" name="caneca" value="@ocupacion.Caneca" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm" disabled="@(ocupacion.UnidadesActuales == 0)">Vaciar esta caneca</button>
                    </form>
                </article>
            }
        </div>
    </section>
</div>
