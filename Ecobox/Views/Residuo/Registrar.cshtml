@model Ecobox.ViewModels.RegistrarResiduoViewModel
@{
    ViewData["Title"] = "Registrar residuo";
}

<div class="container-xl page-shell">
    <section class="page-heading">
        <div>
            <p class="eyebrow">REGISTRO DE PRUEBA</p>
            <h1>Registrar residuo</h1>
            <p class="heading-copy">Registra manualmente una clasificación para probar el conteo de EcoBox.</p>
        </div>
        <a class="btn btn-eco btn-outline-eco" asp-action="Index">Volver al historial</a>
    </section>

    <div class="data-notice notice-connected" role="status">
        <span class="notice-dot" aria-hidden="true"></span>
        <span>La fecha y hora se asignarán automáticamente desde el servidor. Al guardar, se actualizarán el contenedor y el dashboard.</span>
    </div>

    <section class="panel" aria-labelledby="form-title">
        <h2 id="form-title" class="mb-4">Datos de clasificación</h2>
        <form asp-action="Registrar" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Clasificacion" class="form-label"></label>
                <select asp-for="Clasificacion" asp-items="Model.TiposResiduo" class="form-select">
                    <option value="">Selecciona una clasificación</option>
                </select>
                <span asp-validation-for="Clasificacion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="IdContenedor" class="form-label"></label>
                <select asp-for="IdContenedor" asp-items="Model.Contenedores" class="form-select">
                    <option value="0">Selecciona un contenedor</option>
                </select>
                <span asp-validation-for="IdContenedor" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfianzaClasificacion" class="form-label"></label>
                <input asp-for="ConfianzaClasificacion" class="form-control" type="number" min="0" max="1" step="0.01" />
                <div class="form-text">Opcional. Si lo dejas vacío se usará 0.95 como valor de prueba.</div>
                <span asp-validation-for="ConfianzaClasificacion" class="text-danger"></span>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-eco">Guardar residuo</button>
                <a class="btn btn-light-eco" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </section>
</div>
