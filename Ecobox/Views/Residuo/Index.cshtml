@model IReadOnlyList<Ecobox.ViewModels.ResiduoViewModel>
@{
    ViewData["Title"] = "Historial";
}

<div class="container-xl page-shell">
    <section class="page-heading">
        <div><p class="eyebrow">REGISTROS DEL SISTEMA</p><h1>Historial de residuos</h1><p class="heading-copy">Consulta las clasificaciones registradas en EcoBox.</p></div>
        <a class="btn btn-eco btn-outline-eco" asp-controller="Dashboard" asp-action="Index">Volver al dashboard</a>
    </section>
    @if (TempData["MensajeExito"] is string mensajeExito)
    {
        <div class="alert alert-success" role="status">@mensajeExito</div>
    }
    @if (TempData["MensajeError"] is string mensajeError)
    {
        <div class="alert alert-danger" role="alert">@mensajeError</div>
    }
    <div class="data-notice notice-pending" role="status"><span class="notice-dot" aria-hidden="true"></span><span>@ViewBag.MensajeBaseDatos</span></div>
    <section class="panel history-panel">
        @if (Model.Count == 0)
        {
            <div class="history-empty"><span aria-hidden="true">▤</span><h2>Aún no hay registros</h2><p>Los residuos aparecerán cuando la clasificación esté conectada y se registren en la base de datos.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table history-table align-middle mb-0">
                    <thead><tr><th>Fecha</th><th>Hora</th><th>Clasificación</th><th>Contenedor</th><th>Confianza</th></tr></thead>
                    <tbody>
                    @foreach (var residue in Model)
                    {
                        <tr>
                            <td>@residue.FechaHoraDeteccion.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>@residue.FechaHoraDeteccion.ToLocalTime().ToString("hh:mm tt")</td>
                            <td><span class="category-pill @(residue.Clasificacion == "APROVECHABLE" ? "category-green" : "category-blue")">@residue.Clasificacion</span></td>
                            <td>@residue.Contenedor</td>
                            <td>@((residue.ConfianzaClasificacion * 100).ToString("0.#")) %</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
