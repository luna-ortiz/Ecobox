@model Ecobox.ViewModels.CamaraViewModel
@{
    ViewData["Title"] = "Estación de visión";
}

<div class="container-xl page-shell camera-page"
     id="cameraStation"
     data-classify-url="@Url.Action("Clasificar", "Camara")"
     data-rearm-url="@Url.Action("RearmarDeteccion", "Camara")"
     data-status-url="@Url.Action("EstadoVision", "Camara")"
     data-frame-interval-ms="@Model.FrameIntervalMs"
     data-stable-frames="@Model.StableFramesRequired"
     data-cooldown-ms="@Model.DetectionCooldownMs"
     data-presence-threshold="@Model.PresenceChangeThreshold.ToString(System.Globalization.CultureInfo.InvariantCulture)"
     data-roi-ratio="@Model.RoiSizeRatio.ToString(System.Globalization.CultureInfo.InvariantCulture)">
    <section class="page-heading">
        <div>
            <p class="eyebrow">ESTACIÓN INDEPENDIENTE</p>
            <h1>EcoBox · Visión artificial</h1>
            <p class="heading-copy">La cámara y el análisis se inician automáticamente en esta pestaña.</p>
        </div>
    </section>

    <div class="data-notice notice-pending" role="status">
        <span class="notice-dot" aria-hidden="true"></span>
        <span>Deja esta pestaña abierta y activa durante la demostración. El navegador puede reducir el trabajo de las pestañas en segundo plano; el prototipo físico necesitará un proceso de cámara local independiente.</span>
    </div>

    <section class="camera-grid" aria-label="Estación de visión EcoBox">
        <article class="panel camera-panel">
            <div class="panel-heading">
                <div><p class="eyebrow">VISTA EN VIVO</p><h2>Webcam del computador</h2></div>
                <span id="cameraStatusBadge" class="status-pill status-empty">INICIANDO</span>
            </div>
            <div class="camera-frame">
                <video id="cameraVideo" autoplay playsinline muted aria-label="Video en vivo de la webcam"></video>
                <div id="cameraRoiGuide" class="camera-roi-guide" aria-hidden="true"><span>Coloca el residuo aquí</span></div>
                <div id="cameraPlaceholder" class="camera-placeholder"><span aria-hidden="true">◉</span><p>Solicitando acceso a la cámara…</p></div>
            </div>
            <div class="camera-controls">
                <button class="btn btn-light-eco" id="retryCamera" type="button" hidden>Reintentar cámara</button>
            </div>
            <p class="camera-help">Coloca el residuo dentro de la guía. Se analizan frames seleccionados; las imágenes se procesan en memoria y no se guardan.</p>
            <canvas id="captureCanvas" class="visually-hidden"></canvas>
        </article>

        <aside class="panel camera-status-panel">
            <div><p class="eyebrow">ESTADO DEL PROCESO</p><h2>Detección automática</h2></div>
            <div class="camera-state-row"><span>Estado cámara</span><strong id="cameraState">Iniciando…</strong></div>
            <div class="camera-state-row"><span>Estado IA</span><strong id="visionState">Cargando modelo…</strong></div>
            <div class="camera-state-row"><span>Última detección</span><strong id="lastClassification">Sin detecciones</strong></div>
            <div class="camera-state-row"><span>Confianza</span><strong id="lastConfidence">—</strong></div>
            <div class="camera-state-row"><span>Estado</span><strong id="detectionStatus">Calibrando fondo…</strong></div>
            <div id="cameraMessage" class="camera-message" role="status">Esperando que aparezca un residuo frente a la cámara.</div>
        </aside>
    </section>
    <form id="cameraAntiforgery" class="visually-hidden">@Html.AntiForgeryToken()</form>
</div>

@section Scripts {
    <script src="~/js/camara.js" asp-append-version="true"></script>
}
