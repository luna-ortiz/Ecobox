<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f7f8" />
    <title>@ViewData["Title"] · EcoBox</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container-xl">
                <a class="navbar-brand brand-lockup" asp-controller="Dashboard" asp-action="Index" aria-label="EcoBox, dashboard">
                    <span class="brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 32 32" fill="none"><path d="M8 10h16l-1.2 16H9.2L8 10Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M6 7h20M13 7V5h6v2m-5 7v8m4-8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M16 3c-2.7 2.2-3.5 4.2-2.4 5.6 1.1 1.4 3.5 1.2 5.1-.1C20.2 7.2 18.9 5 16 3Z" fill="currentColor"/></svg>
                    </span>
                    <span><strong>ECOBOX</strong><small>Separación inteligente</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Historial" asp-action="Index">Historial</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Camara" asp-action="Index" target="_blank" rel="noopener">Cámara</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container-xl d-flex flex-column flex-sm-row justify-content-between gap-2">
            <span>EcoBox · Prototipo académico de clasificación de residuos</span>
            <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
